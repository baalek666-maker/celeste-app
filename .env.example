# Frontend (client) — variables exposées au navigateur via Vite
# Le préfixe VITE_ est obligatoire pour qu'elles soient accessibles

# Publishable key Stripe (côté client uniquement, pas secrète)
# → https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# URL de l'API backend
VITE_API_URL=https://pokevendrepro.com/celeste/api

# ─── Monitoring (optionnel — laissé vide = désactivé) ───
# Sentry: error tracking → https://sentry.io (créer un projet React)
# VITE_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX

# PostHog: product analytics → https://posthog.com (créer un projet)
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://app.posthog.com

# ─── OAuth Google (obligatoire pour activer "Continuer avec Google") ───
# Côté front : VITE_GOOGLE_CLIENT_ID — créer un OAuth Client Web sur
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins : https://celeste.example.com (ton domaine)
VITE_GOOGLE_CLIENT_ID=

# Côté backend : mêmes valeurs que le front + Client Secret
# GOOGLE_CLIENT_ID=même valeur que VITE_GOOGLE_CLIENT_ID
# APPLE_CLIENT_ID=service ID Apple (à créer sur https://developer.apple.com)
# APPLE_BUNDLE_ID=com.example.celeste

# Mode démo OAuth (DEV ONLY — n'active JAMAIS en prod)
# Si OAUTH_DEMO_MODE=1 côté serveur ET VITE_OAUTH_DEMO=true côté front,
# le backend accepte les tokens mock.* sans vérifier la signature.
# OAUTH_DEMO_MODE=0
# VITE_OAUTH_DEMO=false